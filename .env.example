# Copy to .env and fill in. Never commit .env.

# Required
LLM_API_KEY=
SONIOX_API_KEY=
CARTESIA_API_KEY=

# Language model: any OpenAI-compatible chat-completions provider (OpenAI when the URL is unset)
# LLM_BASE_URL=
# LLM_REASONING_EFFORT=none
# LLM_TEMPERATURE=
# TALKER_MODEL=gpt-6-luna
# STRATEGIST_MODEL=gpt-6-luna
# TRANSLATOR_MODEL=gpt-6-luna
#
# Meta Muse Spark instead (contributor tier: cheaper, and Meta may use the traffic to improve
# its models; Muse Spark always reasons, so "none" is rejected):
# LLM_BASE_URL=https://api.meta.ai/v1
# LLM_REASONING_EFFORT=minimal
# TALKER_MODEL=muse-spark-1.3-contributor
# STRATEGIST_MODEL=muse-spark-1.3-contributor
# TRANSLATOR_MODEL=muse-spark-1.3-contributor

# Speech (defaults shown)
# SONIOX_MODEL=stt-rt-v5
# CARTESIA_MODEL=sonic-3.6
# CARTESIA_VOICE_ID=aa3ccc4a-cfd8-405c-acf5-1873a527b006

# Turn handling: lexicon (default) or onnx with a model path
# BACKCHANNEL_CLASSIFIER=lexicon
# BACKCHANNEL_ONNX_PATH=

# How the caller sounds, heard by SenseVoice (off when unset; about 300 MB of memory when on).
# Fetch the model with: uv run python scripts/fetch_emotion_model.py
# CALLER_EMOTION_MODEL_DIR=models/sense-voice

# Phone line (all three together, or none)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# PUBLIC_BASE_URL=https://example.com

# Browser softphone through Twilio, for trying the phone line without a number (all three
# together, or none; needs the phone line). See README, "Try the phone line".
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_TWIML_APP_SID=

# Deployed behind the Cloudflare Worker (see web/wrangler.jsonc)
# PROXY_SHARED_SECRET=
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=

# Guardrails (defaults shown)
# MAX_CALL_SECONDS=300
# DAILY_PHONE_SECONDS=3600
# DAILY_BROWSER_SECONDS=3600
# CALLS_PER_CALLER_PER_DAY=25
# RETENTION_DAYS=30

# Runtime
# DATA_DIR=var
# CONTENT_DIR=content
# STUN_URL=stun:stun.l.google.com:19302
# ENABLE_DEV_CLIENT=false      # serves Pipecat's prebuilt client at /client
# HOST=127.0.0.1
# PORT=7860
# LOG_LEVEL=INFO
# OTEL_EXPORTER_OTLP_ENDPOINT=  # spans carry transcripts and model text; see DECISIONS #23
